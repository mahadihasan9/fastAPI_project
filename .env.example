# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://fastapi_user:secretpassword@localhost:3306/photo_db

# Fallback to SQLite if MySQL is unavailable
FALLBACK_TO_SQLITE=True

# Security settings
MAX_FAILED_ATTEMPTS=5
BLOCK_DURATION_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
ADMIN_RATE_LIMIT_PER_MINUTE=10

# Secret key for session cookies
SESSION_SECRET_KEY=super_secure_random_session_secret_key_998877665544
